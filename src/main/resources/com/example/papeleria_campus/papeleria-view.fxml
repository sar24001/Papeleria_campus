<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720" prefWidth="857.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.papeleria_campus.controller.PapeleriaController">

    <top>
        <VBox prefHeight="494.0" prefWidth="1068.0" spacing="12">
            <padding>
                <Insets bottom="10" left="20" right="20" top="15" />
            </padding>

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de productos" />

            <GridPane hgap="12" prefHeight="239.0" prefWidth="818.0" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="100" />
                    <ColumnConstraints prefWidth="180" />
                </columnConstraints>

                <Label text="Código:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtCodigo" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Precio:" GridPane.rowIndex="2" />
                <TextField fx:id="txtPrecio" promptText="0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Categoría:" GridPane.rowIndex="3" />
                <ComboBox fx:id="cmbCategoria" prefWidth="180" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="Stock:" GridPane.rowIndex="4" />
            <TextField fx:id="txtStock" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <Label text="Nombre:" GridPane.rowIndex="1" />
            <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
               <RowConstraints />
               <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="btnNuevo" onAction="#NuevoProducto" text="Nuevo" />
                <Button fx:id="btnGuardar" onAction="#GuardarProducto" text="Guardar" />
                <Button fx:id="btnActualizar" onAction="#ActualizarProducto" text="Actualizar" />
                <Button fx:id="btnEliminar" onAction="#EliminarProducto" text="Eliminar" />
            </HBox>

            <Separator />

            <Label style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Búsqueda y filtros" />

            <GridPane hgap="12" prefHeight="125.0" prefWidth="936.0" vgap="10">
                <columnConstraints>
                    <ColumnConstraints prefWidth="100" />
                    <ColumnConstraints prefWidth="180" />
                </columnConstraints>

                <Label text="Código o nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtBuscar" promptText="Buscar..." GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Precio mínimo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtPrecioMin" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <CheckBox fx:id="chkConExistencias" text="Solo productos con existencias" GridPane.columnSpan="2" GridPane.rowIndex="3" />
            <Label text="Categoria:" GridPane.rowIndex="2" />
            <ComboBox fx:id="cmbfiltroCategoria" prefHeight="26.0" prefWidth="181.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
               <RowConstraints />
                </rowConstraints>
            </GridPane>

            <HBox spacing="8">
                <Button fx:id="btnBuscar" onAction="#BuscarProducto" text="Buscar" />
                <Button fx:id="btnLimpiarFiltros" onAction="#LimpiarFiltro" text="Limpiar filtros" />
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaProductos" BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="20" left="20" right="20" top="5" />
            </BorderPane.margin>

            <placeholder>
                <Label text="Tabla sin contenido" />
            </placeholder>

            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="120" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="220" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="170" text="Categoría" />
                <TableColumn fx:id="colPrecio" prefWidth="100" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="90" text="Stock" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>

</BorderPane>
